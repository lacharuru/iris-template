<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Incident Response Report</title>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <style>
        /* --- GENERAL STYLE (SCREEN VISUAL) --- */
        @page { size: A4; margin: 0; }
        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #e0e0e0;
            color: #333;
            font-size: 11px;
            -webkit-print-color-adjust: exact;
        }

        /* A4 centered sheet */
        .page-container {
            width: 210mm;
            min-height: 297mm;
            margin: 30px auto;
            background-color: #fff;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            position: relative;
        }

        /* --- PRINT STYLE (CLEAN PDF) --- */
        @media print {
            @page { margin: 0; size: A4; }
            body { background-color: #fff; margin: 0; }
            .page-container { width: 100%; margin: 0; box-shadow: none; min-height: auto; }
            .footer { position: fixed; bottom: 0; }
            tr { page-break-inside: avoid; }
        }

        /* --- HEADER --- */
        table.header-table {
            width: 100%;
            background-color: #1a2a44;
            color: white;
            border-collapse: collapse;
        }
        table.header-table td {
            padding: 25px 20mm;
            vertical-align: middle;
        }
        .header-title h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 600;
            text-transform: uppercase;
            text-align: right;
        }
        .header-subtitle {
            text-align: right;
            font-size: 11px;
            opacity: 0.9;
            margin-top: 5px;
        }
        .logo-img { max-height: 45px; display: block; }

        .content { padding: 10mm 20mm 20mm 20mm; }

        /* --- SECTION TITLES --- */
        h2 {
            color: #1a2a44;
            font-size: 14px;
            font-weight: 700;
            margin-top: 25px;
            margin-bottom: 10px;
            border-left: 5px solid #1a2a44;
            padding-left: 10px;
            text-transform: uppercase;
        }

        /* --- 1. CASE INFO TABLE --- */
        table.case-info {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
            border: 1px solid #1a2a44;
        }
        table.case-info th {
            background-color: #1a2a44;
            color: white;
            padding: 10px 12px;
            text-align: left;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 10px;
            border: 1px solid #1a2a44;
        }
        table.case-info td {
            background-color: #fcfcfc;
            color: #333;
            padding: 10px 12px;
            border: 1px solid #ddd;
            font-size: 12px;
            vertical-align: middle;
        }
        
        .label-title { width: 15%; }
        .value-title { 
            background-color: #f4f6f7 !important; 
            font-size: 14px; 
            font-weight: bold; 
            color: #000; 
        }

        /* --- DATA TABLES --- */
        table.data-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            border: 1px solid #ddd;
        }
        table.data-table th {
            background-color: #1a2a44;
            color: white;
            padding: 6px;
            text-align: left;
            font-weight: 600;
            font-size: 10px;
            text-transform: uppercase;
        }
        table.data-table td {
            padding: 6px;
            border: 1px solid #e0e0e0;
            color: #444;
            vertical-align: top;
        }
        table.data-table tr:nth-child(even) { background-color: #f9f9f9; }

        .content-box {
            background-color: #fff;
            padding: 10px;
            border: 1px solid #e0e0e0;
            line-height: 1.5;
            text-align: justify;
            white-space: pre-wrap;
        }

        /* --- LOGS --- */
        .log-box {
            border-left: 3px solid #6c757d;
            background-color: #f8f9fa;
            padding: 8px;
            margin-bottom: 5px;
            font-family: Consolas, monospace;
            font-size: 10px;
            border-bottom: 1px solid #eee;
        }

        .footer {
            width: 100%;
            text-align: center;
            font-size: 9px;
            color: #999;
            padding: 20px 0;
            border-top: 1px solid #eee;
            background: #fff;
        }
        
        /* --- STATUS BADGES --- */
        .badge {
            padding: 3px 8px; 
            border-radius: 4px; 
            font-size: 9px; 
            font-weight: bold;
            text-transform: uppercase;
            color: white;
            display: inline-block;
            min-width: 60px;
            text-align: center;
        }
        .bg-done { background-color: #28a745; }
        .bg-progress { background-color: #007bff; }
        .bg-hold { background-color: #ffc107; color: #333; }
        .bg-todo { background-color: #6c757d; }
        .bg-canceled { background-color: #dc3545; }
        
        /* --- MARKDOWN CONTENT STYLES --- */
        .markdown-content {
            line-height: 1.6;
            color: #333;
        }
        .markdown-content h1, 
        .markdown-content h2, 
        .markdown-content h3 {
            color: #1a2a44;
            margin-top: 15px;
            margin-bottom: 8px;
            font-weight: 700;
            text-transform: none;
            border-bottom: 1px solid #eee;
            padding-bottom: 3px;
        }
        .markdown-content table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
            font-size: 11px;
            border: 1px solid #ddd;
        }
        .markdown-content th {
            background-color: #1a2a44;
            color: white;
            padding: 6px;
            text-align: left;
            font-weight: 600;
        }
        .markdown-content td {
            padding: 6px;
            border: 1px solid #e0e0e0;
            vertical-align: top;
        }
        .markdown-content tr:nth-child(even) { background-color: #f9f9f9; }
        .markdown-content pre {
            background-color: #f4f6f7;
            border: 1px solid #ccc;
            padding: 8px;
            border-radius: 4px;
            overflow-x: auto;
            font-family: Consolas, monospace;
            font-size: 10px;
            margin: 10px 0;
        }
        .markdown-content code {
            background-color: #f1f1f1;
            padding: 2px 4px;
            border-radius: 3px;
            font-family: Consolas, monospace;
            color: #d63384;
        }
        .markdown-content blockquote {
            border-left: 4px solid #1a2a44;
            margin: 10px 0;
            padding-left: 10px;
            color: #555;
            font-style: italic;
        } 
    </style>
</head>
<body>

    <div class="page-container">
        
        <table class="header-table">
            <tr>
                <td align="left">
                    <img src="https://YOUR-IRIS-SERVER-IP/static/assets/img/logo-white.png" alt="IRIS Logo" class="logo-img">
                </td>
                <td align="right">
                    <div class="header-title">
                        <h1>Incident Response Report</h1>
                        <div class="header-subtitle">Security Operations Center (SOC)<br> Confidential Document</div>
                    </div>
                </td>
            </tr>
        </table>

        <div class="content">
            
            <h2>GENERAL INFORMATION</h2>
            <table class="case-info">
                <tr>
                    <th class="label-title">TITLE</th>
                    <td colspan="3" class="value-title">{{ case.soc_id }} - {{ case.name }}</td>
                </tr>
                <tr>
                    <th class="label-title">ANALYST</th>
                    <td style="width: 35%;">{{ user }}</td>
                    <th style="width: 15%;">DATE</th>
                    <td style="width: 35%;">{{ case.open_date }}</td>
                </tr>
            </table>

            <h2>ASSETS</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 50%">IP</th>
                        <th style="width: 50%">Description</th>
                    </tr>
                </thead>
                <tbody>
                {% for asset in assets %}
                    <tr>
                        <td>{{ asset.asset_ip if asset.asset_ip else '-' }}</td>
                        <td><b>{{ asset.asset_name }}</b></td>
                    </tr>
                {% else %}
                    <tr><td colspan="2" style="text-align: center; color: #999;">No assets linked.</td></tr>
                {% endfor %}
                </tbody>
            </table>

            <h2>SUMMARY</h2>
            
            <div id="raw-markdown-content" style="display: none;">
                {{ case.description }}
            </div>

            <div id="rendered-markdown" class="content-box markdown-content">
                Loading summary...
            </div>

            <script>
                document.addEventListener("DOMContentLoaded", function() {
                    var rawTextElement = document.getElementById('raw-markdown-content');
                    var targetElement = document.getElementById('rendered-markdown');
                    
                    if (rawTextElement && targetElement) {
                        var rawText = rawTextElement.textContent;
                        
                        if (typeof marked !== 'undefined') {
                            targetElement.innerHTML = marked.parse(rawText);
                        } else {
                            targetElement.innerText = rawText;
                            console.error("Marked.js library failed to load.");
                        }
                    }
                });
            </script>
            <h2>TIMELINE</h2>
            {% for event in timeline %}
                <div class="log-box">
                    <strong>[{{ event.event_date }}] {{ event.event_title }}</strong><br>
                    <span style="color: #555;">Source: {{ event.event_source }}</span><br>
                    <div style="margin-top: 3px; white-space: pre-wrap; color: #333;">{{ event.event_content }}</div>
                </div>
            {% else %}
                <div style="text-align: center; color: #999; padding: 10px; border: 1px dashed #ccc;">
                    No events recorded in the timeline.
                </div>
            {% endfor %}

            <h2>COLLECTED EVIDENCE</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 40%">Filename</th>
                        <th style="width: 30%">Date</th>
                        <th style="width: 30%">Uploaded By</th>
                    </tr>
                </thead>
                <tbody>
                {% for evidence in evidences %}
                    <tr>
                        <td><b>{{ evidence.filename }}</b></td>
                        <td>{{ evidence.date_added }}</td>
                        <td>{{ evidence.added_by }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" style="text-align: center; color: #999;">No evidence attached.</td></tr>
                {% endfor %}
                </tbody>
            </table>
            
            <h2>INDICATORS OF COMPROMISE (IoCs)</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 15%">Type</th>
                        <th style="width: 45%">Value</th>
                        <th style="width: 40%">Context</th>
                    </tr>
                </thead>
                <tbody>
                {% for ioc in iocs %}
                    <tr>
                        <td>
                            {% if ioc.ioc_type.type_name is defined %}
                                {{ ioc.ioc_type.type_name }}
                            {% else %}
                                {{ ioc.ioc_type }}
                            {% endif %}
                        </td>
                        
                        <td style="font-family: monospace; font-weight: bold;">{{ ioc.ioc_value }}</td>
                        <td>{{ ioc.ioc_description }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" style="text-align: center; color: #999;">No IoCs recorded.</td></tr>
                {% endfor %}
                </tbody>
            </table>

            <h2>TASKS</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 50%">Task</th>
                        <th style="width: 25%">Update</th>
                        <th style="width: 25%">Status</th>
                    </tr>
                </thead>
                <tbody>
                {% for task in tasks %}
                    <tr>
                        <td>
                            <b>{{ task.task_title }}</b><br>
                            <span style="font-size: 9px; color: #666;">
                                {{ task.task_description }}
                            </span>
                        </td>
                        <td>{{ task.task_last_update }}</td>
                        <td>
                            <span class="badge 
                                {% if task.task_status == 'Done' %} bg-done
                                {% elif task.task_status == 'In progress' %} bg-progress
                                {% elif task.task_status == 'On hold' %} bg-hold
                                {% elif task.task_status == 'Canceled' %} bg-canceled
                                {% else %} bg-todo
                                {% endif %}">
                                {{ task.task_status }}
                            </span>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" style="text-align: center; color: #999;">No tasks recorded.</td></tr>
                {% endfor %}
                </tbody>
            </table>

        </div>

        <div class="footer">
            Report generated via IRIS • {{ report_date }} <br>
            {{ case.client.customer_name }} <br>
            
            Template developed by 
            <a href="https://github.com/lacharuru" target="_blank" style="color: inherit; text-decoration: none; font-weight: bold;">
                @lacharuru
            </a> • 2026
        </div>
    </div>

</body>
</html>
